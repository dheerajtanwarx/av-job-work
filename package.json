{
  "name": "av-erp",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:seed": "pnpm --filter @av/db run seed",
    "db:setup": "pnpm db:indexes && pnpm db:seed",
    "db:indexes": "pnpm --filter @av/db run indexes"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  }
}
