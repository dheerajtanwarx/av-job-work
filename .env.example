# Database (docker compose)
DATABASE_URL="postgresql://averp:averp@localhost:5432/av_erp"
TEST_DATABASE_URL="postgresql://averp:averp@localhost:5432/av_erp_test"

# API
API_PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
WEB_ORIGIN="http://localhost:3000"

# Owner login created by `pnpm db:seed`
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="admin123"
OWNER_NAME="Owner"

# Email: new sub bills are emailed to the job worker (skipped when SMTP_HOST is empty).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<an App Password>.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Web (Next.js proxies /api/* to this)
API_URL="http://localhost:4000"
