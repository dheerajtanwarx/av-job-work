# Database: MongoDB Atlas (Database → Connect → Drivers). Keep the database name in the path.
# Tests wipe their database, so TEST_MONGODB_URI must name one ending in "_test".
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/av_erp?retryWrites=true&w=majority&appName=av-erp"
TEST_MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/av_erp_test?retryWrites=true&w=majority&appName=av-erp"
# Optional connection pool size (defaults: 20 max, 2 kept warm).
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=2

# API
API_PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
WEB_ORIGIN="http://localhost:3000"
# Public address of the web app (QR codes, PDF links sent on WhatsApp). Defaults to WEB_ORIGIN.
PUBLIC_WEB_URL=""

# Owner login created by `pnpm db:seed`
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="admin123"
OWNER_NAME="Owner"

# Email: new sub bills are emailed to the job worker (skipped when SMTP_HOST is empty).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<an App Password>.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# WhatsApp: the button on returns and material issues opens the job worker's chat with the message and a link to
# the receipt PDF (PUBLIC_WEB_URL must be reachable from their phone). Optional: fill these in to have the server send
# the PDF file itself through the WhatsApp Business API. See README → WhatsApp receipts.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_RETURN="return_receipt"
WHATSAPP_TEMPLATE_ISSUE="material_issue"
WHATSAPP_TEMPLATE_LANG="en"

# Photo storage: set all three to keep photos on Cloudinary (needed on hosts without a persistent disk, e.g. Vercel).
# Empty: photos are saved on local disk under UPLOAD_DIR (default: ./uploads).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Web (Next.js proxies /api/* to this)
API_URL="http://localhost:4000"
