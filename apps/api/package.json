{
  "name": "@av/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc --noEmit && node ../../scripts/hostinger-bundle-api.mjs && sh ../../scripts/hostinger-node-modules.sh @av/api --prod",
    "start": "node server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@av/db": "workspace:*",
    "@av/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.4.2",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
